# Copy to .env and adjust. Never put real credentials here; per-tool credentials
# belong in the client's own vault (TODO: vault integration).
ASPIRE_MCP_SERVER_NAME=aspire-mcp
ASPIRE_MCP_LOG_LEVEL=INFO
# Comma-separated allowlist of tools to expose
ASPIRE_MCP_ALLOWED_TOOLS=echo
# 1 = kill switch on (no tools exposed)
ASPIRE_MCP_KILL_SWITCH=0
ASPIRE_MCP_MAX_INPUT_CHARS=1000
